# =====================================================================
# UYW4Q Backend - Environment Variables Template (.env.example)
# NOTA: Nunca subir archivos .env con claves reales al repositorio.
# Copiar este archivo a .env y completar los valores requeridos.
# =====================================================================

# Configuración del Servidor
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Supabase (PostgreSQL + Auth + Storage)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key-de-supabase
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-opcional

# HaveIBeenPwned API (Breach Check)
# Si se deja vacío o 'mock', el sistema utiliza datos simulados para no gastar cuota en desarrollo
HIBP_API_KEY=mock

# Proveedor de Inteligencia Artificial (Bloque B)
# Opciones: gemini, openai, mock
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Flag de modo seguro (cumplimiento Ley de Delitos Informáticos: solo escaneo pasivo)
STRICT_PASSIVE_SCAN=true
